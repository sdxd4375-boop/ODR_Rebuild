OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
TAVILY_API_KEY=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=
LANGSMITH_TRACING=

# Only necessary for Open Agent Platform
SUPABASE_KEY=
SUPABASE_URL=
# Should be set to true for a production deployment on Open Agent Platform. Should be set to false otherwise, such as for local development.
GET_API_KEYS_FROM_CONFIG=false

# ---------------------------------------------------------------------------
# Self-hosted server (src/server) — frontend + session persistence
# ---------------------------------------------------------------------------
# PostgreSQL DSN (asyncpg driver for the app; the checkpointer derives its own
# psycopg DSN from this value). Start a local Postgres with:
#   docker compose -f docker-compose.dev.yml up -d
DATABASE_URL=postgresql+asyncpg://postgres:nodr@localhost:5433/nodr

# AUTH_MODE: "local" = no authentication, fixed dev user + cost caps (dev only).
#            "supabase" = verify Supabase JWTs (requires SUPABASE_URL/KEY).
# Default: "supabase" if SUPABASE_URL is set, otherwise "local".
AUTH_MODE=

# Directory of the built frontend served by FastAPI (cd web && npm run build).
# Only used in production; leave unset during development.
WEB_DIST=web/dist